# Copy this file to .env for local development, or set the same
# variable in Render's dashboard under Environment for deployment.

# URL of the backend API (no trailing slash). The app appends /api to this.
# Example: https://embz-backend.onrender.com
REACT_APP_BACKEND_URL=

# Set to "true" only if you want the local dev-server health-check
# endpoints from plugins/health-check enabled. Leave unset/false in production.
ENABLE_HEALTH_CHECK=false
