# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Merchize (from seller.merchize.com -> Integrations -> API) - optional, leave blank until you have it
MERCHIZE_API_KEY=
MERCHIZE_API_BASE=https://open.merchize.com/api/v1
MERCHIZE_WEBHOOK_SECRET=change-me

# AI shopping assistant - free, no credit card. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stripe (dashboard.stripe.com -> Developers -> API keys). Payments settle straight to
# YOUR Stripe account - there's no third party in the middle. Leave blank and checkout
# will show a friendly "payments not configured yet" message instead of erroring.
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> add endpoint -> https://YOUR-DOMAIN/api/stripe/webhook
# -> select event "checkout.session.completed" -> reveal the signing secret and paste it here.
STRIPE_WEBHOOK_SECRET=
# Optional: your live site URL, used to build the Stripe success/cancel redirect. Vercel
# sets this automatically on deploy, so you usually don't need to set it yourself.
NEXT_PUBLIC_SITE_URL=
